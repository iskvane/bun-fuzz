{
  "name": "bun-fuzz",
  "module": "src/server/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "build:native": "cargo build --release --manifest-path native/garage-synth/Cargo.toml",
    "build": "bun run build:native && bun run scripts/build.ts",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
